{
  "name": "my-three-body-cv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "content": "tsx scripts/validate-manifest.ts && tsx scripts/compile-ink.ts && tsx scripts/build-cv-pdf.ts",
    "predev": "pnpm content",
    "dev": "next dev",
    "prebuild": "pnpm content",
    "build": "next build",
    "start": "serve out -l 3000",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "palette": "tsx scripts/export-palette.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@xstate/react": "^6.0.0",
    "inkjs": "^2.3.2",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "xstate": "^5.20.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.0.0",
    "eslint-config-prettier": "^10.1.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.6.0",
    "serve": "^14.2.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
