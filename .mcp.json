{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "firefox",
        "--headless",
        "--isolated",
        "--viewport-size",
        "1280x720",
        "--output-dir",
        ".playwright-mcp"
      ]
    }
  }
}
